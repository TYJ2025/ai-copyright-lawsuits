node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Local secrets / API tokens (COURTLISTENER_TOKEN etc.)
.env
.env.*
!.env.example

# Claude local-only
.claude/settings.local.json
.claude/worktrees/

